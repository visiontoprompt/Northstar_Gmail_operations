[Unit]
Description=Loopback-only VNC server for the Northstar virtual desktop
Requires=northstar-xvfb.service northstar-openbox.service
After=northstar-xvfb.service northstar-openbox.service

[Service]
Type=simple
User=northstar
Group=northstar
Environment=DISPLAY=:99
Environment=HOME=/var/lib/northstar
ExecStart=/usr/bin/x11vnc -display :99 -localhost -nopw -forever -shared -rfbport 5900 -noxdamage -repeat -xkb
Restart=on-failure
RestartSec=2
PrivateTmp=false
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
