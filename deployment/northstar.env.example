ENVIRONMENT=production
AUTH_REQUIRED=true
ALLOW_INITIAL_ADMIN_SETUP=false
DATABASE_URL=postgresql+psycopg://northstar:replace-me@127.0.0.1:5432/northstar
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=generate-a-unique-random-secret-and-store-outside-source-control
# Keep the previous key during a rotation window; remove only after data re-encryption.
# SECRET_KEY_PREVIOUS=previous-secret-key
ADMIN_API_TOKEN=generate-a-separate-long-random-break-glass-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=https://app.example.com
PROFILE_ROOT=/var/lib/northstar/browser-profiles
BROWSER_LAUNCH_ENABLED=false
BROWSER_OBSERVER_ENABLED=false
BROWSER_DESKTOP_ENABLED=false
WORKER_ENABLED=true
# Optional OVH US Floating IP recovery. The cloud file and proxy credentials
# are server-side secrets; never commit populated values to source control.
OVH_PROXY_RECOVERY_ENABLED=true
OVH_PROXY_RECOVERY_PROJECT_ID=239fa25938524e2f87575cc424a2b6fc
OVH_PROXY_RECOVERY_INSTANCE_ID=e998e455-3c20-40f3-bd9b-63d74a57d4de
OVH_PROXY_RECOVERY_REGION=US-EAST-VA-1
OVH_PROXY_RECOVERY_PORT=18080
OVH_PROXY_RECOVERY_USERNAME=
OVH_PROXY_RECOVERY_PASSWORD=
OVH_PROXY_RECOVERY_IP_CHECK_URL=https://api4.ipify.org
OVH_PROXY_RECOVERY_READINESS_TIMEOUT_SECONDS=600
OVH_PROXY_RECOVERY_NETWORK_GRACE_SECONDS=90
OVH_PROXY_RECOVERY_PROBE_ATTEMPTS=3
OVH_PROXY_RECOVERY_POLL_SECONDS=5
OPENSTACK_CLOUD=northstar-ovh-us
OS_CLIENT_CONFIG_FILE=/etc/northstar/openstack/clouds.yaml
