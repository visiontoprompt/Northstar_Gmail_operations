[Unit]
Description=Northstar SaaS API and worker
After=network-online.target postgresql.service redis-server.service northstar-xvfb.service northstar-websockify.service
Wants=network-online.target northstar-websockify.service
Requires=northstar-xvfb.service

[Service]
Type=simple
User=northstar
Group=northstar
WorkingDirectory=/opt/northstar/backend
EnvironmentFile=/etc/northstar/northstar.env
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=HOME=/var/lib/northstar
Environment=TMPDIR=/var/lib/northstar/tmp
ExecStartPre=/opt/northstar/backend/.venv/bin/python -m alembic -c /opt/northstar/backend/alembic.ini upgrade head
ExecStart=/opt/northstar/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
# Chrome's Linux sandbox may need its setuid helper when launched under
# systemd. Keep Chrome's own sandbox enabled rather than disabling it with
# --no-sandbox; the service still runs as the unprivileged northstar user.
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/northstar

[Install]
WantedBy=multi-user.target
