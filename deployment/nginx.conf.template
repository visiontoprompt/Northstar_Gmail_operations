# Install as /etc/nginx/sites-available/northstar after replacing app.example.com
# and provisioning a valid certificate with Certbot.
limit_req_zone $binary_remote_addr zone=northstar_auth:10m rate=10r/m;

server {
    listen 80;
    server_name app.example.com;
    location /.well-known/acme-challenge/ { root /var/www/northstar-certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name app.example.com;
    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    client_max_body_size 11m;
    root /opt/northstar/frontend/dist;
    index index.html;

    location = /api/v1/auth/login {
        limit_req zone=northstar_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }
    location = /api/v1/auth/password-reset/request {
        limit_req zone=northstar_auth burst=2 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location = /_desktop_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/api/v1/desktop/authorize;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Original-URI $request_uri;
    }
    location ^~ /desktop/ {
        auth_request /_desktop_auth;
        alias /usr/share/novnc/;
        add_header Cache-Control "no-store" always;
    }
    location = /websockify {
        auth_request /_desktop_auth;
        proxy_pass http://127.0.0.1:6080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location = /websockify/ {
        auth_request /_desktop_auth;
        proxy_pass http://127.0.0.1:6080/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
