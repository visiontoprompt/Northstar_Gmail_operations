ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/gmail_ops.db
# Replace in every shared/production environment with a managed secret.
SECRET_KEY=replace-with-a-random-secret-managed-outside-the-repository
# Required outside development; send as Authorization: Bearer <token>.
ADMIN_API_TOKEN=replace-with-a-managed-admin-token
CORS_ORIGINS=http://localhost:5173
# Local development only: launch a separate browser process per account profile.
BROWSER_LAUNCH_ENABLED=false
BROWSER_EXECUTABLE=google-chrome
# Directory holding the persistent per-account user-data folders. Defaults to
# <project-root>/data/browser-profiles. Uncomment to relocate.
# PROFILE_ROOT=data/browser-profiles
# Redis-backed worker queue (set for production; tests default to fakeredis://).
REDIS_URL=redis://localhost:6379/0
# Worker thread drives heartbeat, stale-lock recovery and periodic dispatch.
WORKER_ENABLED=false
WORKER_POLL_INTERVAL=5.0
WORKER_HEARTBEAT_TTL=30
WORKER_HEARTBEAT_INTERVAL=10.0
WORKER_STALE_SECONDS=90
WORKER_LOCK_TTL=120
WORKER_RETRY_LIMIT=3
WORKER_MAX_ACTIVE_PROFILES=50
WORKER_RELEASE_ON_COMPLETE=true
# Playwright observer that launches each account's saved profile as a normal
# Chrome window (persistent context, no --remote-debugging-port or automation
# flags on the command line) and drives sign-in: it observes and records page
# state, advances safe consent interstitials, auto-fills the stored
# email/password, and generates + enters the TOTP when Google asks. Pauses only
# on CAPTCHA/unknown pages. The saved profile/cookies persist in PROFILE_ROOT
# for future no-login sessions. dev.sh enables it automatically.
BROWSER_OBSERVER_ENABLED=false
# Seconds between observation polls.
BROWSER_OBSERVE_INTERVAL=1.0
# Seconds a page must stay unrecognized before the automation pauses for a
# human. A settle window prevents a still-loading page from failing a session.
BROWSER_OBSERVE_SETTLE_SECONDS=5.0
# Allow the observer to type the stored account email/password into Google's
# own sign-in form and to enter the TOTP generated from the stored 2FA secret.
# CAPTCHA and truly unknown pages still pause for a human.
BROWSER_AUTO_LOGIN=false
