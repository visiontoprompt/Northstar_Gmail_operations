ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/gmail_ops.db
# Replace in every shared/production environment with a managed secret.
SECRET_KEY=replace-with-a-random-secret-managed-outside-the-repository
CORS_ORIGINS=http://localhost:5173
# Local development only: launch a separate Chrome process per account profile.
BROWSER_LAUNCH_ENABLED=false
BROWSER_EXECUTABLE=google-chrome
PROFILE_ROOT=data/browser-profiles
