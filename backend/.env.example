ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/gmail_ops.db
# Replace in every shared/production environment with a managed secret.
SECRET_KEY=replace-with-a-random-secret-managed-outside-the-repository
CORS_ORIGINS=http://localhost:5173
# Local development only: launch a separate Chrome process per account profile.
BROWSER_LAUNCH_ENABLED=false
BROWSER_EXECUTABLE=google-chrome
PROFILE_ROOT=data/browser-profiles
# Redis-backed worker queue (set for production; tests default to fakeredis://).
REDIS_URL=redis://localhost:6379/0
# Worker thread drives heartbeat, stale-lock recovery and periodic dispatch.
WORKER_ENABLED=false
WORKER_POLL_INTERVAL=5.0
WORKER_HEARTBEAT_TTL=30
WORKER_HEARTBEAT_INTERVAL=10.0
WORKER_STALE_SECONDS=90
WORKER_LOCK_TTL=120
WORKER_RETRY_LIMIT=3
WORKER_MAX_ACTIVE_PROFILES=50
WORKER_RELEASE_ON_COMPLETE=true
